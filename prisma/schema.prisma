generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String          @id @default(uuid())
  email                  String          @unique
  passwordHash           String
  name                   String?
  organizationId         String
  role                   String          @default("MEMBER")
  onboarded              Boolean         @default(false)
  languageCode           String          @default("en")
  localeCode             String          @default("en-US")
  avatarUrl              String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  enrichmentRuns         EnrichmentRun[]
  leads                  Lead[]
  activities             LeadActivity[]
  approvedOutreachDrafts OutreachDraft[] @relation("DraftApprover")
  createdOutreachDrafts  OutreachDraft[] @relation("DraftCreator")
  sessions               Session[]
  organization           Organization    @relation(fields: [organizationId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                           String                        @id @default(uuid())
  name                         String
  apiCredits                   Int                           @default(0)
  timezone                     String                        @default("UTC")
  locale                       String                        @default("en")
  country                      String?
  industry                     String?
  logoUrl                      String?
  brandColor                   String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  aiUsageRecords               AIUsageRecord[]
  auditLogs                    AuditLog[]
  businessGoals                BusinessGoal[]
  businessInsights             BusinessInsight[]
  BusinessMetric               BusinessMetric[]
  BusinessProfile              BusinessProfile?
  conversations                Conversation[]
  creditAccount                CreditAccount?
  creditTransactions           CreditTransaction[]
  discoveryJobs                DiscoveryJob[]
  discoveryResults             DiscoveryResult[]
  enrichmentEvidence           EnrichmentEvidence[]
  enrichmentRuns               EnrichmentRun[]
  actionPlans                  ExecutiveActionPlan[]
  executiveBriefings           ExecutiveBriefingRecord[]
  decisions                    ExecutiveDecision[]
  executiveEvents              ExecutiveEvent[]
  executiveForecasts           ExecutiveForecast[]
  governancePolicy             ExecutiveGovernancePolicy?
  learningSignals              ExecutiveLearningSignal[]
  executiveMemories            ExecutiveMemoryEntry[]
  executiveOutcomes            ExecutiveOutcome[]
  executiveOutcomeAttributions ExecutiveOutcomeAttribution[]
  executiveRecommendations     ExecutiveRecommendation[]
  IntegrationConnection        IntegrationConnection[]
  leads                        Lead[]
  leadActivities               LeadActivity[]
  MetricSnapshot               MetricSnapshot[]
  billing                      OrganizationBilling?
  outreachDrafts               OutreachDraft[]
  providerCredentials          ProviderCredential[]
  SyncJob                      SyncJob[]
  systemTelemetryEvents        SystemTelemetryEvent[]
  usageRecords                 UsageRecord[]
  users                        User[]
}

model Lead {
  id                 String               @id @default(uuid())
  organizationId     String
  companyName        String
  domain             String?
  contactName        String?
  contactEmail       String?
  contactTitle       String?
  phone              String?
  location           String?
  source             String?
  notes              String?
  enrichmentData     String?
  score              Int?
  scoreType          String?              @default("RULE_BASED")
  aiScore            Int?
  aiSummary          String?
  status             String               @default("DISCOVERED")
  ownerId            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  enrichmentEvidence EnrichmentEvidence[]
  enrichmentRuns     EnrichmentRun[]
  organization       Organization         @relation(fields: [organizationId], references: [id])
  owner              User?                @relation(fields: [ownerId], references: [id])
  activities         LeadActivity[]
  outreachDrafts     OutreachDraft[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, ownerId])
}

model LeadActivity {
  id             String       @id @default(uuid())
  organizationId String
  leadId         String
  userId         String?
  type           String
  content        String
  oldValue       String?
  newValue       String?
  createdAt      DateTime     @default(now())
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([organizationId, createdAt])
}

model ProviderCredential {
  id             String       @id @default(uuid())
  organizationId String
  provider       String
  encryptedKey   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model DiscoveryJob {
  id             String            @id @default(uuid())
  organizationId String
  status         String            @default("QUEUED")
  criteria       String
  progress       Int               @default(0)
  total          Int               @default(0)
  processed      Int               @default(0)
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id])
  results        DiscoveryResult[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model DiscoveryResult {
  id                 String       @id @default(uuid())
  discoveryJobId     String
  organizationId     String
  provider           String
  providerRecordId   String?
  companyName        String
  domain             String?
  contactName        String?
  contactEmail       String?
  contactTitle       String?
  phone              String?
  location           String?
  metadata           String?
  score              Int?
  verificationStatus String?
  createdAt          DateTime     @default(now())
  job                DiscoveryJob @relation(fields: [discoveryJobId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([discoveryJobId])
}

model Plan {
  id              String                @id @default(uuid())
  name            String
  slug            String                @unique
  description     String?
  monthlyPrice    Int
  monthlyCredits  Int
  active          Boolean               @default(true)
  stripePriceId   String?               @unique
  features        String?
  limits          String?
  billingInterval String                @default("monthly")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  billings        OrganizationBilling[]
}

model OrganizationBilling {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  planId               String
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  subscriptionStatus   String       @default("ACTIVE")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan         @relation(fields: [planId], references: [id])

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model CreditAccount {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  availableBalance Int          @default(0)
  reservedBalance  Int          @default(0)
  lifetimeGranted  Int          @default(0)
  lifetimeConsumed Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id             String       @id @default(uuid())
  organizationId String
  amount         Int
  type           String
  referenceType  String?
  referenceId    String?
  description    String?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([referenceType, referenceId])
}

model UsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  discoveryJobId String?
  provider       String?
  operation      String
  credits        Int
  metadata       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([discoveryJobId])
}

model WebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  eventType     String
  status        String   @default("PROCESSED")
  error         String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  sessionId      String?
  conversationId String?
  action         String
  resource       String?
  resourceId     String?
  input          String?
  output         String?
  ipAddress      String?
  userAgent      String?
  status         String
  riskLevel      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([userId])
}

model Conversation {
  id             String          @id @default(uuid())
  organizationId String
  userId         String
  title          String?
  channel        String          @default("web")
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]
  pendingActions PendingAction[]

  @@index([organizationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  toolCall       String?
  toolResult     String?
  audioUrl       String?
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PendingAction {
  id               String            @id @default(uuid())
  organizationId   String
  requestingUserId String
  approvingUserId  String?
  conversationId   String
  actionType       String
  actionName       String
  actionArgs       String
  humanDescription String
  riskLevel        String
  executionResult  String?
  failureReason    String?
  idempotencyKey   String            @unique
  status           String            @default("WAITING")
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  outcome          ExecutiveOutcome?
  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([conversationId, status])
}

model AIUsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  provider       String
  model          String
  requestType    String
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model BusinessProfile {
  id                  String       @id @default(uuid())
  organizationId      String       @unique
  industry            String?
  businessName        String
  timezone            String       @default("UTC")
  currency            String       @default("USD")
  locale              String       @default("en-US")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  businessModel       String?
  operatingPriorities String?
  targetMarket        String?
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Integration {
  id          String                  @id @default(uuid())
  provider    String                  @unique
  name        String
  type        String
  createdAt   DateTime                @default(now())
  connections IntegrationConnection[]
}

model IntegrationConnection {
  id             String       @id @default(uuid())
  organizationId String
  integrationId  String
  status         String       @default("ACTIVE")
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncJobs       SyncJob[]

  @@unique([organizationId, integrationId])
  @@index([organizationId])
}

model SyncJob {
  id                      String                @id @default(uuid())
  organizationId          String
  integrationConnectionId String
  status                  String                @default("QUEUED")
  startedAt               DateTime?
  completedAt             DateTime?
  recordsProcessed        Int                   @default(0)
  errorMessage            String?
  createdAt               DateTime              @default(now())
  durationMs              Int?
  errorCode               String?
  retryCount              Int                   @default(0)
  trigger                 String                @default("SYSTEM")
  updatedAt               DateTime              @updatedAt
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([integrationConnectionId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, integrationConnectionId, status])
}

model BusinessMetric {
  id             String           @id @default(uuid())
  organizationId String
  key            String
  name           String
  description    String?
  unit           String
  category       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots      MetricSnapshot[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model MetricSnapshot {
  id             String         @id @default(uuid())
  organizationId String
  metricId       String
  timestamp      DateTime
  value          Float
  source         String
  createdAt      DateTime       @default(now())
  metric         BusinessMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, timestamp])
  @@index([organizationId, metricId, timestamp])
}

model BusinessInsight {
  id               String       @id @default(uuid())
  organizationId   String
  type             String
  severity         String
  title            String
  summary          String
  explanation      String
  metricName       String?
  currentValue     Float?
  baselineValue    Float?
  changePercentage Float?
  status           String       @default("NEW")
  fingerprint      String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, createdAt])
}

model OutreachDraft {
  id              String       @id @default(uuid())
  organizationId  String
  leadId          String
  subject         String
  body            String
  tone            String       @default("CONSULTATIVE_VALUE")
  intelligence    String
  generationMode  String
  contextHash     String
  version         Int          @default(1)
  status          String       @default("DRAFT")
  createdBy       String
  approvedBy      String?
  rejectedBy      String?
  rejectionReason String?
  pendingActionId String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  approvedAt      DateTime?
  approver        User?        @relation("DraftApprover", fields: [approvedBy], references: [id])
  creator         User         @relation("DraftCreator", fields: [createdBy], references: [id])
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId])
  @@index([organizationId, status])
  @@index([contextHash])
}

model EnrichmentRun {
  id                 String               @id @default(uuid())
  organizationId     String
  leadId             String
  status             String               @default("RUNNING")
  providersRequested String
  providersCompleted String
  requestedBy        String
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  errorCode          String?
  errorMessage       String?
  evidence           EnrichmentEvidence[]
  lead               Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [requestedBy], references: [id])

  @@index([organizationId, leadId])
  @@index([organizationId, status])
}

model EnrichmentEvidence {
  id                 String        @id @default(uuid())
  organizationId     String
  leadId             String
  runId              String
  field              String
  value              String
  sourceType         String
  sourceUrl          String?
  provider           String
  confidence         String
  verificationStatus String        @default("VERIFIED")
  observedAt         DateTime      @default(now())
  expiresAt          DateTime?
  lead               Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrichmentRun      EnrichmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId])
  @@index([runId])
  @@index([field])
}

model BusinessGoal {
  id             String             @id @default(uuid())
  organizationId String
  title          String
  kpiKey         String
  targetValue    Float
  currentValue   Float              @default(0)
  unit           String
  startDate      DateTime           @default(now())
  endDate        DateTime
  status         String             @default("ON_TRACK")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  period         String             @default("CUSTOM")
  source         String             @default("USER_DEFINED")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outcomes       ExecutiveOutcome[]

  @@index([organizationId, status])
  @@index([organizationId, kpiKey])
}

model ExecutiveMemoryEntry {
  id             String            @id @default(uuid())
  organizationId String
  category       String
  title          String
  summary        String
  facts          String
  observations   String
  outcome        String?
  sourceActionId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outcomeRecord  ExecutiveOutcome?

  @@index([organizationId, category])
  @@index([organizationId, createdAt])
}

model ExecutiveRecommendation {
  id               String            @id @default(uuid())
  organizationId   String
  domain           String            @default("REVENUE")
  priorityScore    Int
  priorityLevel    String
  title            String
  executiveSummary String
  reasoning        String
  expectedImpact   String
  confidence       String
  actionProposal   String
  status           String            @default("ACTIVE")
  pendingActionId  String?           @unique
  createdAt        DateTime          @default(now())
  expiresAt        DateTime?
  outcome          ExecutiveOutcome?
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, priorityLevel])
  @@index([organizationId, createdAt])
}

model ExecutiveEvent {
  id             String       @id @default(uuid())
  organizationId String
  eventType      String
  domain         String
  severity       String
  title          String
  summary        String
  sourceTable    String
  sourceRecordId String?
  facts          String
  metadata       String?
  fingerprint    String?
  occurredAt     DateTime
  createdAt      DateTime     @default(now())
  processed      Boolean      @default(false)
  processedAt    DateTime?
  resolved       Boolean      @default(false)
  resolvedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, eventType])
  @@index([organizationId, processed])
  @@index([organizationId, severity])
  @@index([organizationId, fingerprint])
}

model ExecutiveBriefingRecord {
  id                 String       @id @default(uuid())
  organizationId     String
  healthScore        Int
  healthSummary      String
  executiveSummary   String
  topPriorities      String
  keyChanges         String
  risks              String
  opportunities      String
  recommendedActions String
  supportingFacts    String
  observations       String?
  hypotheses         String?
  generatedBy        String
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model ExecutiveOutcome {
  id                    String                       @id @default(uuid())
  organizationId        String
  recommendationId      String                       @unique
  pendingActionId       String?                      @unique
  domain                String
  targetKpiKey          String?
  targetGoalId          String?
  status                String                       @default("MEASURING")
  measurementWindowDays Int                          @default(7)
  startedAt             DateTime                     @default(now())
  evaluationDueAt       DateTime
  evaluatedAt           DateTime?
  beforeSnapshot        String
  afterSnapshot         String?
  decisionId            String?
  expectedValue         Float?
  actualValue           Float?
  variance              Float?
  variancePercentage    Float?
  varianceStatus        String?
  confidence            String?
  effectivenessStatus   String?
  baselineValue         Float?
  finalValue            Float?
  deltaValue            Float?
  deltaPercentage       Float?
  healthScoreDelta      Int?
  resultStatus          String?
  attributionLevel      String?
  attributionRationale  String?
  hypothesisStatus      String?
  falsified             Boolean                      @default(false)
  effectivenessScore    Int?
  executiveMemoryId     String?                      @unique
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  executiveMemory       ExecutiveMemoryEntry?        @relation(fields: [executiveMemoryId], references: [id])
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pendingAction         PendingAction?               @relation(fields: [pendingActionId], references: [id])
  recommendation        ExecutiveRecommendation      @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  targetGoal            BusinessGoal?                @relation(fields: [targetGoalId], references: [id])
  attribution           ExecutiveOutcomeAttribution?

  @@index([organizationId, status])
  @@index([organizationId, resultStatus])
  @@index([organizationId, evaluationDueAt])
  @@index([organizationId, domain])
}

model ExecutiveGovernancePolicy {
  id                                String       @id @default(uuid())
  organizationId                    String       @unique
  riskTolerance                     String       @default("MEDIUM")
  maxFinancialExposure              Float        @default(10000.0)
  maxLeadCapacityPerRep             Int          @default(50)
  restrictedDomains                 String       @default("[]")
  restrictedActions                 String       @default("[]")
  minEvidenceConfidence             Int          @default(70)
  requireExecutiveApprovalAboveRisk String       @default("HIGH")
  policyVersion                     Int          @default(1)
  createdAt                         DateTime     @default(now())
  updatedAt                         DateTime     @updatedAt
  organization                      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ExecutiveDecision {
  id                    String                   @id @default(uuid())
  organizationId        String
  strategyId            String?
  recommendationId      String?
  pendingActionId       String?
  title                 String
  description           String
  domain                String
  decisionType          String
  status                String                   @default("PENDING")
  priority              String                   @default("MEDIUM")
  requiredAuthority     String                   @default("MANAGER")
  governanceVerdict     String
  governanceExplanation String
  policyVersion         Int                      @default(1)
  riskScore             Int                      @default(0)
  financialExposure     Float                    @default(0.0)
  evidenceConfidence    Int                      @default(0)
  requestedByUserId     String?
  decidedByUserId       String?
  decisionReason        String?
  metadata              String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  decidedAt             DateTime?
  expiresAt             DateTime?
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditHistory          ExecutiveDecisionAudit[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, requiredAuthority])
  @@index([organizationId, createdAt])
}

model ExecutiveDecisionAudit {
  id             String            @id @default(uuid())
  decisionId     String
  organizationId String
  actorUserId    String?
  event          String
  fromStatus     String?
  toStatus       String
  reason         String?
  policyVersion  Int               @default(1)
  metadata       String?
  createdAt      DateTime          @default(now())
  decision       ExecutiveDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt])
  @@index([organizationId, createdAt])
}

model ExecutiveLearningSignal {
  id                 String       @id @default(uuid())
  organizationId     String
  decisionId         String?
  outcomeId          String?
  domain             String
  strategyKey        String?
  metric             String
  expectedValue      Float?
  actualValue        Float?
  variance           Float?
  variancePercentage Float?
  varianceStatus     String
  effectiveness      String
  confidence         String
  hypothesisResult   String
  evidence           String?
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, domain])
  @@index([organizationId, varianceStatus])
  @@index([organizationId, effectiveness])
  @@index([organizationId, createdAt])
}

model ExecutiveForecast {
  id              String       @id @default(uuid())
  organizationId  String
  sourceType      String
  sourceId        String?
  domain          String
  metric          String
  currentValue    Float
  forecastValue   Float
  forecastHorizon String
  horizonDays     Int          @default(30)
  lowerBound      Float
  upperBound      Float
  confidence      String
  direction       String
  scenarioType    String       @default("BASELINE")
  evidence        String
  assumptions     String       @default("[]")
  riskSignals     String       @default("[]")
  metadata        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, domain])
  @@index([organizationId, metric])
  @@index([organizationId, forecastHorizon])
  @@index([organizationId, confidence])
  @@index([organizationId, createdAt])
}

