# ==========================================
# LeadMachine Dedicated Database Configuration
# ==========================================
# Runtime application connection (pooled for serverless)
DATABASE_URL="postgresql://leadmachine_app:your_password@ep-leadmachine-pooler.region.neon.tech/leadmachine_production?sslmode=require&pgbouncer=true"

# Direct administrative connection for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://leadmachine_admin:your_password@ep-leadmachine.region.neon.tech/leadmachine_production?sslmode=require"

# Database Write Safety Gate (Fail-Closed: Must be strictly 'true' and 'leadmachine')
LEADMACHINE_DB_WRITES_ENABLED="false"
LEADMACHINE_DATABASE_ID="leadmachine"
LEADMACHINE_DB_ENVIRONMENT="development" # development | preview | production

# ==========================================
# Security & Authentication
# ==========================================
SESSION_SECRET="your_secure_session_secret_min_32_chars"
PROVIDER_ENCRYPTION_KEY="your_secure_encryption_key_min_32_chars"
INTERNAL_JOB_SECRET="your_internal_job_secret"

# ==========================================
# Stripe Billing (Phase 7)
# ==========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_BUSINESS="price_..."

# ==========================================
# Upstash Redis (Rate Limiting)
# ==========================================
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ==========================================
# Inngest (Background Processing)
# ==========================================
INNGEST_EVENT_KEY="..."
INNGEST_SIGNING_KEY="..."
